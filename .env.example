# Signing secret for session tokens. Generate: openssl rand -hex 32
CIPHER_TOKEN_SECRET=replace-me-with-32-bytes-of-hex
# HTTP port for the API + WebSocket gateway.
CIPHER_PORT=8787
# SQLite file. ":memory:" for an ephemeral instance.
CIPHER_DB_PATH=./data/cipher.db
# Workspace retention cap in seconds. Clamps every message TTL. Max 604800 (7d).
CIPHER_MAX_TTL_SECONDS=604800
# Serve the built web bundle from ./dist (set for production single-process deploys).
CIPHER_SERVE_STATIC=false
# Comma-separated STUN/TURN URLs for calls, e.g. "stun:stun.example.org:3478".
# Empty means calls only connect on a local network: a STUN server learns the caller's
# address, so reaching past NAT is left as a deliberate choice.
CIPHER_ICE_SERVERS=
# Read X-Forwarded-For. Enable ONLY behind a proxy that overwrites that header,
# otherwise clients can forge the address the rate limiter keys on.
CIPHER_TRUST_PROXY=false
